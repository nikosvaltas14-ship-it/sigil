# Optional. Copy to .env for non-secret settings. .env is gitignored.
#
# Secrets (Telegram bot token and chat id, Moodle token, iCloud login) never go
# in this file: Sigil ignores them here. Store them in the OS credential store:
#   python -m sigil.study_guides set-secret TELEGRAM_BOT_TOKEN
#   python -m sigil.study_guides set-secret TELEGRAM_CHAT_ID
#   python -m sigil.study_guides login --browser      (Moodle token)
#   python -m sigil.study_guides calendar-login       (iCloud, optional)

# Where runtime data (caches, logs, built PDFs) goes.
# Default: %LOCALAPPDATA%\sigil-study (Windows) or ~/.local/share/sigil-study.
SIGIL_DATA_DIR=
